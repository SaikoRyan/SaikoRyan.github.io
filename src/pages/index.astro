---
import BaseLayout from "../layouts/BaseLayout.astro";
import { education, papers, profile, siteMeta, teaching } from "../data/site";
---

<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <div class="rail" aria-hidden="true">
    <div class="rail-fill"></div>
  </div>

  <header class="topbar">
    <div class="wrap topbar-inner">
      <a class="mark" href="#home">{profile.name}</a>
      <nav aria-label="On this page">
        <a href="#about">About</a>
        <a href="#papers">Papers</a>
        <a href="#experience">Experience</a>
      </nav>
    </div>
  </header>

  <nav class="dots" aria-label="Sections">
    <a href="#home" class="active" aria-label="Home"></a>
    <a href="#about" aria-label="About"></a>
    <a href="#papers" aria-label="Papers"></a>
    <a href="#experience" aria-label="Experience"></a>
  </nav>

  <section class="panel" id="home">
    <div class="wrap hero">
      <div>
        <p class="kicker reveal" style="--d: 0">Homepage</p>
        <h1 class="reveal" style="--d: 1">{profile.name}</h1>
        <p class="role reveal" style="--d: 2">{profile.role}</p>
        <p class="intro reveal" style="--d: 3">{profile.intro}</p>
        <p class="line reveal" style="--d: 4">{profile.institution}</p>
        <p class="line reveal" style="--d: 5">{profile.department} · Advised by {profile.advisor}</p>
        <p class="email reveal" style="--d: 6">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
      </div>
      <div class="photo-frame reveal-photo">
        <img
          class="photo"
          src={profile.photo}
          alt={`Portrait of ${profile.name}`}
          width="320"
          height="400"
        />
      </div>
    </div>
  </section>

  <section class="panel" id="about">
    <div class="wrap panel-inner">
      <div class="about-top">
        <div>
          <p class="kicker reveal" style="--d: 0">About</p>
          <h2 class="panel-title reveal" style="--d: 1">Who I am</h2>
        </div>
        <div class="measure">
          {profile.bio.map((paragraph, index) => (
            <p class="reveal" style={`--d: ${index + 2}`}>{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="panel panel-papers" id="papers">
    <div class="wrap panel-inner">
      <div class="section-head">
        <p class="kicker reveal" style="--d: 0">Working Papers</p>
        <h2 class="panel-title reveal" style="--d: 1">Selected research</h2>
      </div>
      <div class="paper-grid">
        {papers.map((paper, index) => (
          <article class="paper reveal" style={`--d: ${index + 1}`}>
            <p class="venue">{paper.venue}</p>
            <h3>
              <a href={paper.href} target="_blank" rel="noopener">
                {paper.title}
              </a>
            </h3>
            <p class="authors">{paper.authors}</p>
            <p class="insight">{paper.insight}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="panel" id="experience">
    <div class="wrap panel-inner">
      <div class="section-head">
        <p class="kicker reveal" style="--d: 0">Experience</p>
        <h2 class="panel-title reveal" style="--d: 1">Education and teaching</h2>
      </div>
      <div class="split">
        <div class="surface reveal" style="--d: 2">
          <h3>Education</h3>
          {education.map((entry) => (
            <article class="record">
              <div class="record-head">
                <p class="record-title">{entry.degree}</p>
                <p class="when">{entry.period}</p>
              </div>
              <p class="where">{entry.school}</p>
              {entry.details.map((detail) => <p class="where">{detail}</p>)}
            </article>
          ))}
        </div>
        <div class="surface reveal" style="--d: 3">
          <h3>Teaching</h3>
          {teaching.map((entry) => (
            <article class="record">
              <div class="record-head">
                <p class="record-title">{entry.title}</p>
                <p class="when">{entry.period}</p>
              </div>
              <p class="where">{entry.organization}</p>
              {entry.details.map((detail) => <p class="where">{detail}</p>)}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const railFill = document.querySelector(".rail-fill") as HTMLElement | null;
  const panels = [...document.querySelectorAll(".panel")];
  const dots = [...document.querySelectorAll(".dots a")];
  const navs = [...document.querySelectorAll(".topbar nav a")];

  const setActive = (id: string) => {
    dots.forEach((dot) => dot.classList.toggle("active", dot.getAttribute("href") === `#${id}`));
    navs.forEach((link) => link.classList.toggle("active", link.getAttribute("href") === `#${id}`));
  };

  const reveal = (panel: Element) => {
    panel.classList.add("is-in");
    panel.querySelectorAll(".reveal, .reveal-photo").forEach((el) => el.classList.add("in"));
  };

  let railTicking = false;
  const updateRail = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const progress = max > 0 ? window.scrollY / max : 0;
    if (railFill) railFill.style.transform = `scaleY(${progress})`;
    railTicking = false;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (railTicking) return;
      railTicking = true;
      requestAnimationFrame(updateRail);
    },
    { passive: true }
  );
  updateRail();

  if (reduceMotion) {
    document.querySelectorAll(".reveal, .reveal-photo").forEach((el) => el.classList.add("in"));
    panels.forEach((panel) => panel.classList.add("is-in"));
    setActive("home");
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          reveal(entry.target);
          setActive(entry.target.id);
        });
      },
      { threshold: 0.28 }
    );

    panels.forEach((panel) => observer.observe(panel));
    reveal(document.querySelector("#home") as Element);
  }
</script>
