---
import BaseLayout from "../layouts/BaseLayout.astro";
import { education, papers, profile, siteMeta, teaching } from "../data/site";
---

<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <main class="page">
    <header id="home">
      <div>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p>{profile.institution}</p>
        <p>{profile.department}</p>
        <p>Advised by {profile.advisor}</p>
        <p>
          Email: <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
        <nav>
          <a href="#about">About</a>
          <a href="#papers">Papers</a>
          <a href="#education">Education</a>
          <a href="#teaching">Teaching</a>
        </nav>
      </div>
      <img
        src={profile.photo}
        alt={`Portrait of ${profile.name}`}
        width="200"
        height="250"
      />
    </header>

    <section id="about">
      <h2>About</h2>
      {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section id="papers">
      <h2>Selected Papers</h2>
      {papers.map((paper) => (
        <article>
          <p>
            <a href={paper.href} target="_blank" rel="noopener">{paper.title}</a>
          </p>
          <p class="meta">{paper.authors}</p>
          <p class="meta"><em>{paper.venue}</em></p>
          <p>{paper.insight}</p>
        </article>
      ))}
    </section>

    <section id="education">
      <h2>Education</h2>
      {education.map((entry) => (
        <p>
          <strong>{entry.degree}</strong>, {entry.school}, {entry.period}.
          {entry.details.length > 0 ? ` ${entry.details.join(". ")}.` : ""}
        </p>
      ))}
    </section>

    <section id="teaching">
      <h2>Teaching</h2>
      {teaching.map((entry) => (
        <p>
          <strong>{entry.title}</strong>, {entry.organization}, {entry.period}.
          {entry.details.length > 0 ? ` ${entry.details.join("; ")}.` : ""}
        </p>
      ))}
    </section>
  </main>
</BaseLayout>
