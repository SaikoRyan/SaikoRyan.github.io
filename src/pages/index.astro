---
import BaseLayout from "../layouts/BaseLayout.astro";
import { education, papers, profile, siteMeta, teaching } from "../data/site";
---

<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <main class="page">
    <header class="hero" id="home">
      <div class="hero-text">
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p>{profile.institution}</p>
        <p>{profile.department}</p>
        <p>Advised by {profile.advisor}</p>
        <p>
          Email: <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
        <nav aria-label="On this page">
          <a href="#about">About</a>
          <a href="#papers">Papers</a>
          <a href="#education">Education</a>
          <a href="#teaching">Teaching</a>
        </nav>
      </div>
      <img
        class="photo"
        src={profile.photo}
        alt={`Portrait of ${profile.name}`}
        width="220"
        height="280"
      />
    </header>

    <section id="about">
      <h2>About</h2>
      {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section id="papers">
      <h2>Working Papers</h2>
      {papers.map((paper) => (
        <article class="paper">
          <h3>
            <a href={paper.href} target="_blank" rel="noopener">
              {paper.title}
            </a>
          </h3>
          <p class="meta">{paper.authors}</p>
          <p class="meta">{paper.venue}</p>
          <p>{paper.insight}</p>
        </article>
      ))}
    </section>

    <section id="education">
      <h2>Education</h2>
      {education.map((entry) => (
        <article class="entry">
          <p>
            <strong>{entry.degree}</strong>, {entry.school}, {entry.period}
          </p>
          {entry.details.map((detail) => <p class="meta">{detail}</p>)}
        </article>
      ))}
    </section>

    <section id="teaching">
      <h2>Teaching</h2>
      {teaching.map((entry) => (
        <article class="entry">
          <p>
            <strong>{entry.title}</strong>, {entry.organization}, {entry.period}
          </p>
          {entry.details.map((detail) => <p class="meta">{detail}</p>)}
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
