---
import BaseLayout from "../layouts/BaseLayout.astro";
import { education, papers, profile, siteMeta, teaching } from "../data/site";
---

<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a class="mark" href="#home">{profile.name}</a>
      <nav aria-label="On this page">
        <a href="#about">About</a>
        <a href="#papers">Papers</a>
        <a href="#education">Education</a>
        <a href="#teaching">Teaching</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <section class="hero" id="home">
      <div>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="line">{profile.institution}</p>
        <p class="line">{profile.department}</p>
        <p class="line">Advised by {profile.advisor}</p>
        <p class="email">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
      </div>
      <img
        class="photo"
        src={profile.photo}
        alt={`Portrait of ${profile.name}`}
        width="260"
        height="325"
      />
    </section>

    <section class="block" id="about">
      <h2>About</h2>
      <div class="body">
        {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="block" id="papers">
      <h2>Working Papers</h2>
      <div class="body">
        {papers.map((paper) => (
          <article class="paper">
            <h3>
              <a href={paper.href} target="_blank" rel="noopener">
                {paper.title}
              </a>
            </h3>
            <p class="authors">{paper.authors}</p>
            <p class="venue">{paper.venue}</p>
            <p class="insight">{paper.insight}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="block" id="education">
      <h2>Education</h2>
      <div class="body">
        {education.map((entry) => (
          <article class="record">
            <div class="record-head">
              <h3>{entry.degree}</h3>
              <p class="when">{entry.period}</p>
            </div>
            <p class="where">{entry.school}</p>
            {entry.details.map((detail) => <p class="where">{detail}</p>)}
          </article>
        ))}
      </div>
    </section>

    <section class="block" id="teaching">
      <h2>Teaching</h2>
      <div class="body">
        {teaching.map((entry) => (
          <article class="record">
            <div class="record-head">
              <h3>{entry.title}</h3>
              <p class="when">{entry.period}</p>
            </div>
            <p class="where">{entry.organization}</p>
            {entry.details.map((detail) => <p class="where">{detail}</p>)}
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
