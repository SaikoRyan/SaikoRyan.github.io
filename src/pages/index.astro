---
import BaseLayout from "../layouts/BaseLayout.astro";
import { education, papers, profile, siteMeta, teaching } from "../data/site";
---

<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <nav class="navbar">
    <div class="nav-inner">
      <a class="nav-logo" href="#home">{profile.name}</a>
      <ul class="nav-menu">
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#papers">Publications</a></li>
        <li><a href="#teaching">Teaching</a></li>
      </ul>
    </div>
  </nav>

  <section class="hero" id="home">
    <div class="container hero-content">
      <div class="profile-image">
        <img
          src={profile.photo}
          alt={`Portrait of ${profile.name}`}
          width="300"
          height="400"
        />
      </div>
      <div class="hero-text">
        <h1>{profile.name}</h1>
        <p class="title">{profile.role}</p>
        <p class="affiliation">{profile.institution}</p>
        <p class="affiliation">{profile.department}</p>
        <p class="affiliation">Advised by {profile.advisor}</p>
        <div class="contact-info">
          <p>
            Email: <a href={`mailto:${profile.email}`}>{profile.emailDisplay}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <h2>About Me</h2>
      <div class="content">
        {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="papers">
    <div class="container">
      <h2>Working Papers</h2>
      <div class="publications-list">
        {papers.map((paper) => (
          <article class="publication-item">
            <h3>
              <a href={paper.href} target="_blank" rel="noopener">
                {paper.title}
              </a>
            </h3>
            <p class="authors">{paper.authors}</p>
            <p class="venue">{paper.venue}</p>
            <p class="note">{paper.insight}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="education">
    <div class="container">
      <h2>Education</h2>
      <div class="entry-list">
        {education.map((entry) => (
          <article class="entry">
            <p class="entry-degree">
              {entry.degree}
              <span class="entry-period">{entry.period}</span>
            </p>
            <p class="entry-place">{entry.school}</p>
            {entry.details.map((detail) => (
              <p class="entry-detail">{detail}</p>
            ))}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="teaching">
    <div class="container">
      <h2>Teaching</h2>
      <div class="entry-list">
        {teaching.map((entry) => (
          <article class="entry">
            <p class="entry-degree">
              {entry.title}
              <span class="entry-period">{entry.period}</span>
            </p>
            <p class="entry-place">{entry.organization}</p>
            {entry.details.map((detail) => (
              <p class="entry-detail">{detail}</p>
            ))}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
