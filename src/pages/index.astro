---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  contact,
  education,
  papers,
  profile,
  researchInterests,
  siteMeta,
  teaching
} from "../data/site";

const highlightAuthors = (authors: string) =>
  authors.replace(
    /Ruihan Lin/g,
    '<strong class="self-name">Ruihan Lin</strong>'
  );
---

<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <nav class="site-nav" aria-label="Primary">
    <div class="site-nav-inner">
      <a class="hero-mark" href="#top">Ruihan Lin</a>
      <div class="site-nav-links">
        <a href="#about">About</a>
        <a href="#research">Research</a>
        <a href="#education">Education</a>
        <a href="#papers">Papers</a>
        <a href="#teaching">Teaching</a>
        <a href="#contact">Contact</a>
      </div>
    </div>
  </nav>

  <main class="page-shell">
    <header class="hero" id="top">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>{profile.name}</h1>
          <p class="hero-intro">{profile.intro}</p>
          <div class="hero-meta-stack">
            <p class="hero-role">{profile.role}</p>
            <p class="hero-meta">{profile.institution}</p>
            <p class="hero-meta">Advised by {profile.advisor}</p>
          </div>
          <div class="hero-links">
            {profile.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </div>

        <div class="hero-photo-wrap">
          <img
            class="hero-photo"
            src={profile.photo}
            alt={`Portrait of ${profile.name}`}
            width="320"
            height="400"
          />
        </div>
      </div>
    </header>

    <section class="section" id="about">
      <div class="section-heading">
        <p>About Me</p>
      </div>
      <div class="section-body prose">
        {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="section" id="research">
      <div class="section-heading">
        <p>Research</p>
      </div>
      <div class="section-body prose">
        <ul class="interest-list">
          {researchInterests.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section" id="education">
      <div class="section-heading">
        <p>Education</p>
      </div>
      <div class="section-body entry-list">
        {education.map((entry) => (
          <article class="entry-card">
            <div class="entry-header">
              <h2>{entry.school}</h2>
              <p class="entry-period">{entry.period}</p>
            </div>
            <p class="entry-title">{entry.degree}</p>
            {entry.details.length > 0 && (
              <ul class="entry-details">
                {entry.details.map((detail) => <li>{detail}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="papers">
      <div class="section-heading">
        <p>Working Papers</p>
      </div>
      <div class="section-body paper-list">
        {papers.map((paper, index) => (
          <article class="paper-item">
            <p class="paper-index">{String(index + 1).padStart(2, "0")}</p>
            <div class="paper-content">
              <h2>
                <a href={paper.href} target="_blank" rel="noreferrer">
                  {paper.title}
                </a>
              </h2>
              <p class="paper-authors" set:html={highlightAuthors(paper.authors)} />
              <p class="paper-venue">{paper.venue}</p>
              <p class="paper-insight">{paper.insight}</p>
              <ul class="paper-keywords">
                {paper.keywords.map((keyword) => (
                  <li>{keyword}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="teaching">
      <div class="section-heading">
        <p>Teaching</p>
      </div>
      <div class="section-body entry-list">
        {teaching.map((entry) => (
          <article class="entry-card">
            <div class="entry-header">
              <h2>{entry.title}</h2>
              <p class="entry-period">{entry.period}</p>
            </div>
            <p class="entry-title">{entry.organization}</p>
            {entry.details.length > 0 && (
              <ul class="entry-details">
                {entry.details.map((detail) => <li>{detail}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="contact">
      <div class="section-heading">
        <p>Contact</p>
      </div>
      <div class="section-body prose">
        <p>{contact.heading}</p>
        <p>
          Email: <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
        <p>{contact.institution}</p>
        <div class="contact-links">
          {contact.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <p>Last updated {contact.lastUpdated}</p>
    </footer>
  </main>
</BaseLayout>
