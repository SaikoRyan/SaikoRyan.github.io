---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaperCard from "../components/PaperCard.astro";
import { profile, research, papers, siteMeta } from "../data/site";
---

<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <main class="page-shell">
    <header class="hero" id="top">
      <div class="hero-nav">
        <span class="hero-mark">Ruihan Lin</span>
        <nav aria-label="Primary">
          <a href="#about">About</a>
          <a href="#research">Research</a>
          <a href="#papers">Papers</a>
        </nav>
      </div>

      <div class="hero-copy">
        <p class="hero-kicker">Academic Homepage</p>
        <h1>{profile.name}</h1>
        <p class="hero-role">{profile.role}</p>
        <p class="hero-meta">
          Advised by <a href={profile.advisor.href} target="_blank" rel="noreferrer">{profile.advisor.name}</a>
        </p>
        <p class="hero-intro">{profile.intro}</p>

        <div class="hero-links">
          {profile.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </div>
    </header>

    <section class="section" id="about">
      <div class="section-heading">
        <p>About</p>
      </div>
      <div class="section-body prose">
        {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="section" id="research">
      <div class="section-heading">
        <p>Research</p>
      </div>
      <div class="section-body prose">
        {research.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="section section-papers" id="papers">
      <div class="section-heading">
        <p>Selected Papers</p>
      </div>
      <div class="section-body paper-list">
        {papers.map((paper, index) => (
          <PaperCard paper={paper} index={index} />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
