<svg
  viewBox="0 0 640 320"
  role="img"
  aria-labelledby="llmqueue-title llmqueue-desc"
  class="diagram llmqueue-diagram"
>
  <title id="llmqueue-title">LLM inference architecture diagram</title>
  <desc id="llmqueue-desc">
    Request classes are gated into prefill and decode lanes that compete for a shared GPU cluster.
  </desc>

  <defs>
    <linearGradient id="llmqueue-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="rgba(255,255,255,0.72)" />
      <stop offset="100%" stop-color="rgba(232,226,214,0.92)" />
    </linearGradient>
    <linearGradient id="llmqueue-flow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="rgba(43,69,101,0.18)" />
      <stop offset="100%" stop-color="rgba(43,69,101,0.46)" />
    </linearGradient>
    <marker
      id="llmqueue-arrow"
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--accent)" opacity="0.65"></path>
    </marker>
  </defs>

  <rect x="12" y="12" width="616" height="296" rx="28" class="panel"></rect>
  <rect x="160" y="60" width="320" height="200" rx="32" class="flow-area"></rect>

  <g class="request-class">
    <rect x="38" y="72" width="92" height="42" rx="16"></rect>
    <rect x="38" y="132" width="92" height="42" rx="16"></rect>
    <rect x="38" y="192" width="92" height="42" rx="16"></rect>
    <text x="84" y="98">chat</text>
    <text x="84" y="158">batch</text>
    <text x="84" y="218">agent</text>
  </g>

  <g class="labels">
    <text x="40" y="48">request classes</text>
    <text x="220" y="104">prefill lane</text>
    <text x="220" y="212">decode lane</text>
    <text x="492" y="52">shared GPU cluster</text>
  </g>

  <g class="lane lane-prefill">
    <rect x="198" y="116" width="220" height="36" rx="18"></rect>
    <circle cx="232" cy="134" r="5"></circle>
    <circle cx="266" cy="134" r="5"></circle>
    <circle cx="300" cy="134" r="5"></circle>
    <circle cx="334" cy="134" r="5"></circle>
  </g>

  <g class="lane lane-decode">
    <rect x="198" y="172" width="220" height="36" rx="18"></rect>
    <circle cx="248" cy="190" r="5"></circle>
    <circle cx="286" cy="190" r="5"></circle>
    <circle cx="324" cy="190" r="5"></circle>
    <circle cx="362" cy="190" r="5"></circle>
  </g>

  <g class="gate">
    <path
      d="M212 70 C248 44, 368 44, 404 70 C370 90, 246 90, 212 70Z"
      class="gate-shell"
    ></path>
    <text x="308" y="74">gate + route</text>
  </g>

  <g class="gpu-pool">
    <rect x="500" y="74" width="86" height="44" rx="16"></rect>
    <rect x="500" y="132" width="86" height="44" rx="16"></rect>
    <rect x="500" y="190" width="86" height="44" rx="16"></rect>
    <text x="543" y="100">GPU 1</text>
    <text x="543" y="158">GPU 2</text>
    <text x="543" y="216">GPU 3</text>
  </g>

  <g class="connectors">
    <path d="M130 93 C162 93, 172 108, 198 134" marker-end="url(#llmqueue-arrow)"></path>
    <path d="M130 153 C162 153, 176 154, 198 164" marker-end="url(#llmqueue-arrow)"></path>
    <path d="M130 213 C162 213, 176 208, 198 198" marker-end="url(#llmqueue-arrow)"></path>

    <path d="M308 88 L308 112" marker-end="url(#llmqueue-arrow)"></path>
    <path d="M308 88 C324 100, 336 114, 346 128" marker-end="url(#llmqueue-arrow)"></path>
    <path d="M308 88 C324 122, 338 148, 352 172" marker-end="url(#llmqueue-arrow)"></path>

    <path d="M418 134 C452 134, 468 130, 500 126" marker-end="url(#llmqueue-arrow)"></path>
    <path d="M418 190 C452 190, 468 176, 500 166" marker-end="url(#llmqueue-arrow)"></path>

    <path d="M500 214 C470 232, 440 238, 406 236" class="soft-path"></path>
  </g>

  <g class="notes">
    <text x="402" y="254">contention becomes controlled throughput</text>
  </g>
</svg>

<style>
  .diagram {
    display: block;
    width: 100%;
    height: auto;
  }

  .panel {
    fill: url(#llmqueue-bg);
    stroke: rgba(43, 69, 101, 0.12);
    stroke-width: 1;
  }

  .flow-area {
    fill: rgba(255, 255, 255, 0.36);
    stroke: rgba(43, 69, 101, 0.08);
    stroke-width: 1;
  }

  .labels text,
  .notes text {
    fill: rgba(29, 33, 39, 0.7);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .request-class rect,
  .gpu-pool rect {
    fill: rgba(255, 255, 255, 0.68);
    stroke: rgba(43, 69, 101, 0.12);
    stroke-width: 1.2;
  }

  .request-class text,
  .gpu-pool text,
  .gate text {
    fill: var(--accent);
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 14px;
    letter-spacing: 0.05em;
    text-anchor: middle;
  }

  .lane rect {
    fill: url(#llmqueue-flow);
    stroke: rgba(43, 69, 101, 0.08);
    stroke-width: 1;
  }

  .lane circle {
    fill: rgba(255, 255, 255, 0.72);
  }

  .gate-shell {
    fill: rgba(43, 69, 101, 0.09);
    stroke: rgba(43, 69, 101, 0.18);
    stroke-width: 1;
  }

  .connectors path {
    fill: none;
    stroke: rgba(43, 69, 101, 0.58);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .connectors .soft-path {
    stroke-dasharray: 4 7;
    opacity: 0.5;
  }
  </style>
