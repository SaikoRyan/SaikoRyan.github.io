---
const { paper } = Astro.props;
---

<article class="paper-card">
  <p class="paper-meta">{paper.venue}</p>
  <h2>
    <a href={paper.href} target="_blank" rel="noreferrer">
      {paper.title}
    </a>
  </h2>
  <p class="paper-authors">{paper.authors}</p>
  <p class="paper-insight">{paper.insightTitle}</p>
  <p class="paper-caption">{paper.caption}</p>
</article>
