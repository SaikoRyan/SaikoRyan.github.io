---
import LlmInferenceAnimation from "./animations/LlmInferenceAnimation.astro";
import RbfPricingAnimation from "./animations/RbfPricingAnimation.astro";
import LlmJudgeAnimation from "./animations/LlmJudgeAnimation.astro";

const { paper, index = 0 } = Astro.props;

const animationMap = {
  llmInference: LlmInferenceAnimation,
  rbfPricing: RbfPricingAnimation,
  llmJudge: LlmJudgeAnimation
};

const Animation = animationMap[paper.animationId];
---

<article class={`paper-card ${index % 2 === 1 ? "paper-card--reverse" : ""}`}>
  <div class="paper-copy">
    <p class="paper-meta">{paper.venue}</p>
    <h2>
      <a href={paper.href} target="_blank" rel="noreferrer">
        {paper.title}
      </a>
    </h2>
    <p class="paper-authors">{paper.authors}</p>
    <p class="paper-insight">{paper.insightTitle}</p>
    <p class="paper-caption">{paper.caption}</p>
  </div>

  <div class="paper-stage">
    <div class="motion-shell">
      <Animation />
    </div>
  </div>
</article>
