---
const { paper, index } = Astro.props;
---

<article class="paper-card">
  <div class="paper-index-block">
    <p class="paper-index">{String(index + 1).padStart(2, "0")}</p>
  </div>
  <div class="paper-content">
    <p class="paper-meta">{paper.venue}</p>
    <h2>
      <a href={paper.href} target="_blank" rel="noreferrer">
        {paper.title}
      </a>
    </h2>
    <p class="paper-authors">{paper.authors}</p>
    <div class="paper-figures" aria-label="Selected figures from the paper">
      {paper.figures.map((figure) => (
        <figure class="paper-figure">
          <div class="paper-figure-frame">
            <img src={figure.src} alt={figure.alt} loading="lazy" />
          </div>
          <figcaption>
            <span class="paper-figure-kind">{figure.kind}</span>
            <span class="paper-figure-caption">{figure.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="paper-insight">{paper.insightTitle}</p>
    <p class="paper-caption">{paper.caption}</p>
  </div>
</article>
